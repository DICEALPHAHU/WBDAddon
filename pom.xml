<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>alphahu</groupId>
    <artifactId>WBDAddon</artifactId>
    <version>1.0.1</version>
    <packaging>jar</packaging>

    <name>WBDAddon</name>
    <description>WarZBombDefuse 的第三方附加组件合集：击杀报告、回合伤害统计、比赛状态显示、竞技场饥饿锁定、防第三人称、JourneyMap 桥接。</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 构建号 = git 提交短哈希 + 构建时间戳（UTC），产物名形如
             WBDAddon-1.0.1-a4cbeed-20260926-1745.jar：
             哈希能一眼对应到是哪份代码，时间戳用于区分同一提交的多次构建 -->
        <maven.build.timestamp.format>yyyyMMdd-HHmm</maven.build.timestamp.format>
        <!-- 这里刻意不定义 git.commit.id.abbrev 的默认值：
             antrun 里的 Ant 属性是不可变的，若此处先给了值，
             后面 loadproperties 就再也覆盖不掉，产物名会永远停在那个默认值上。 -->
    </properties>

    <repositories>
        <!-- Paper API 仓库 -->
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- PlaceholderAPI 备用仓库，原地址 repo.extendedclip.com 有时连接失败 -->
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.helpch.at/releases/</url>
        </repository>
        <!-- ProtocolLib：遮挡面「只对本人可见」必须走协议层，
             因为 Arclight 上 Player#hideEntity 虽然存在却不起作用 -->
        <repository>
            <id>dmulloy2</id>
            <url>https://repo.dmulloy2.net/repository/public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API，编译期提供，包含 Folia 调度器接口 -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.20.1-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- WarZBombDefuse 本地依赖，需将 wbd.jar 放入 libs/ 目录 -->
        <dependency>
            <groupId>com.warzbombdefuse</groupId>
            <artifactId>wbd-api</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/wbd.jar</systemPath>
        </dependency>

        <!-- PlaceholderAPI，可选依赖，编译期提供。
             运行时服主没装 PAPI 时，只要代码不直接调用 PAPI 的类，插件正常加载。 -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>

        <!-- ProtocolLib，可选依赖，编译期提供。
             防第三人称要靠「遮挡面只对本人可见」，而这件事在 Arclight 上
             只能通过拦数据包实现：Bukkit 的 Player#hideEntity 在那边
             方法存在、调用不报错，但完全不生效。
             运行时服主没装 ProtocolLib 时，只有防第三人称模块降级，其余功能不受影响。 -->
        <dependency>
            <groupId>com.comphenix.protocol</groupId>
            <artifactId>ProtocolLib</artifactId>
            <version>5.3.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- TaczSpigotBridage，可选依赖，（如果你加Tacz枪械那这个是必须的），编译期提供。-->
        <dependency>
            <groupId>com.tacz.bridge</groupId>
            <artifactId>taczspigotbridge-api</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/taczspigotbridge.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <defaultGoal>clean package</defaultGoal>

        <!-- 基础产物名。真正的交付名由后面的 antrun 在打包完成后补上 git 哈希与构建时间戳。
             不能直接写在这里：finalName 在项目加载阶段就被插值，那时插件还没取到 git 信息，
             写 ${git.commit.id.abbrev} 只会拿到 pom 里的默认值 nogit。 -->
        <finalName>${project.artifactId}-${project.version}</finalName>

        <plugins>
            <!-- 取 git 提交短哈希，供产物命名与构建信息展示使用 -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>9.0.1</version>
                <executions>
                    <execution>
                        <id>get-git-info</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- 同时生成 git.properties（会被打进 jar），启动日志读它显示构建来源 -->
                    <generateGitPropertiesFile>true</generateGitPropertiesFile>
                    <abbrevLength>7</abbrevLength>
                    <!-- 源码被拷出仓库、拿不到 git 信息时不要让构建失败 -->
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                    <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- 用 release 而非 source/target：保证只链接 Java 17 的 API，
                         避免在高版本 JDK 上编译出「运行期才炸」的字节码 -->
                    <release>${java.version}</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <!-- 暂无需 shade 的第三方库；如以后引入，在此加 <relocations> -->
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 打包完成后把产物改名为「版本号- git 短哈希-构建时间戳」。
                 必须排在 shade 之后：同一个 phase 内插件按声明顺序执行，
                 否则会把 shade 替换前的原始 jar 改名。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>stamp-artifact-name</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- 从插件生成的 git.properties 里读哈希。
                                     不能直接写 ${git.commit.id.abbrev}：该插件只负责写文件，
                                     并不会把属性注入 Maven，那样只会得到字面量。 -->
                                <loadproperties srcFile="${project.build.outputDirectory}/git.properties"/>
                                <move file="${project.build.directory}/${project.build.finalName}.jar"
                                      tofile="${project.build.directory}/${project.build.finalName}-${git.commit.id.abbrev}-${maven.build.timestamp}.jar"
                                      overwrite="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>